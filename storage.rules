rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // =============================================
    // Lifecycle gate documents (quick 260704-* — re-adds file upload)
    // Uploaded from app/views/project-detail.js & service-detail.js:
    //   projects/{projectId}/{docKey}.{ext}   e.g. inspection_report.pdf
    //   services/{serviceId}/{docKey}.{ext}   e.g. certificate_of_completion.pdf
    // docKey ∈ inspection_report | ntp_document | completion_report |
    //          certificate_of_completion
    //
    // ACCEPTED RISK: Storage rules v2 cannot call firestore.get() to check the
    // caller's role (this project uses no custom claims). The Firestore Security
    // Rules on projects/{id} & services/{id} are the primary write gate; these
    // Storage rules provide an authentication gate + a 10 MB size cap only.
    // Mirrors the stripped Phase 87 proposals storage rules (quick 260511-k4f).
    //
    // NOTE: request.resource is null on delete, so the size check is guarded to
    // keep object deletion (document replace/remove) working.
    // =============================================
    match /projects/{projectId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (request.resource == null
                       || request.resource.size < 10 * 1024 * 1024);
    }
    match /services/{serviceId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (request.resource == null
                       || request.resource.size < 10 * 1024 * 1024);
    }
  }
}
